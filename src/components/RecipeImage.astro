---
import { resolveRecipeImage } from '@/lib/recipeImage';

interface Props {
  image: string;
  imageAlt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  draggable?: boolean | 'true' | 'false';
  width?: number;
  height?: number;
  sizes?: string;
}

const {
  image,
  imageAlt,
  class: className = '',
  loading = 'lazy',
  draggable = 'false',
  width = 1200,
  height = 800,
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px',
} = Astro.props;

const isGoogleShareUrl = (() => {
  try {
    const url = new URL(image);
    return url.protocol === 'https:' && url.hostname === 'share.google';
  } catch {
    return false;
  }
})();
const { src: resolvedSrc, fallbackSrc } = resolveRecipeImage(
  isGoogleShareUrl ? '' : image
);
const src = isGoogleShareUrl ? fallbackSrc : resolvedSrc;
---

<img
  class={`recipe-img ${className}`}
  src={src}
  alt={imageAlt || 'Recipe image'}
  width={width}
  height={height}
  sizes={sizes}
  loading={loading}
  decoding="async"
  draggable={draggable}
  data-fallback={fallbackSrc}
  data-google-image-share={isGoogleShareUrl ? image : undefined}
/>

<script>
  document
    .querySelectorAll<HTMLImageElement>('img.recipe-img[data-fallback]')
    .forEach(img => {
      const sharedUrl = img.dataset.googleImageShare;
      if (sharedUrl) {
        void fetch(`/api/resolve-image?url=${encodeURIComponent(sharedUrl)}`)
          .then(async response => {
            const result = (await response.json()) as {
              ok: boolean;
              url?: string;
              error?: string;
            };
            if (!response.ok || !result.ok || !result.url) {
              throw new Error(result.error || 'Could not resolve image URL.');
            }
            img.src = result.url;
          })
          .catch(error => {
            console.error('Could not display Google-shared recipe image:', error);
          });
      }

      img.addEventListener('error', () => {
        const fallback = img.dataset.fallback;
        if (fallback && img.src !== fallback) {
          img.src = fallback;
        }
      });
    });
</script>
