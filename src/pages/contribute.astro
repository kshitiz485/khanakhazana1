---
import MainLayout from '@layouts/MainLayout.astro';
import ContributionField from '@components/form/ContributionField.astro';

export const prerender = false;

import { CONTRIBUTE_FIELDS, HONEYPOT_FIELD } from '@/lib/contribution';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const formConfigured = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL &&
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const essentialFields = CONTRIBUTE_FIELDS.filter(field =>
  [
    'title',
    'description',
    'cookingTime',
    'servings',
    'ingredients',
    'steps',
  ].includes(field.name)
);
const optionalFields = CONTRIBUTE_FIELDS.filter(
  field => !essentialFields.includes(field)
);
---

<MainLayout
  title="Contribute a Recipe | Khana Khazana"
  description="Share your recipe with the Khana Khazana community via an easy online form."
  robots="noindex, follow"
>
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:py-20">
    <h1 class="text-dark text-3xl font-bold text-balance sm:text-4xl dark:text-stone-100">
      Contribute a recipe
    </h1>
    <p class="mt-4 text-stone-600 2xl:text-lg dark:text-stone-400">
      Add your recipe details and it will be published for the community.
    </p>

    <form
      id="contribute-form"
      class="mt-10 space-y-6"
      method="POST"
      action="/api/contribute"
    >
      <div class="grid gap-6 sm:grid-cols-2">
        {essentialFields.map(field => (
          <div class:list={[field.width === 'half' ? '' : 'sm:col-span-2']}>
            <ContributionField field={field} />
          </div>
        ))}
      </div>

      <details class="group rounded-3xl border border-orange-200/80 bg-orange-50/50 px-5 py-4 dark:border-stone-700 dark:bg-stone-900/40">
        <summary class="cursor-pointer list-none font-semibold text-stone-700 marker:hidden dark:text-stone-200">
          Optional details
          <span class="float-right text-xl leading-5 text-orange-500 transition group-open:rotate-45">
            +
          </span>
        </summary>
        <div class="mt-5 grid gap-6 sm:grid-cols-2">
          {optionalFields.map(field => (
            <div class:list={[field.width === 'half' ? '' : 'sm:col-span-2']}>
              <ContributionField field={field} />
            </div>
          ))}
        </div>
      </details>

      {/* Honeypot */}
      <div class="hidden" aria-hidden="true">
        <label for={HONEYPOT_FIELD}>Website</label>
        <input
          id={HONEYPOT_FIELD}
          name={HONEYPOT_FIELD}
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      {turnstileSiteKey && (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="auto"
        />
      )}

      <p
        id="form-status"
        class="hidden text-sm"
        role="status"
        aria-live="polite"
      ></p>

      <div class="flex flex-wrap items-center gap-3">
        <button
          type="submit"
          id="contribute-submit"
          disabled={!formConfigured}
          class="bg-secondary text-dark hover:bg-secondary-accent focus-visible:ring-secondary corner-squircle inline-flex items-center justify-center rounded-4xl px-5 py-2.5 font-medium transition-colors focus-visible:ring-2 focus-visible:outline-hidden disabled:cursor-not-allowed disabled:opacity-50"
        >
          Publish recipe
        </button>
        {!formConfigured && (
          <span class="text-xs text-stone-500 dark:text-stone-400">
            Online submission is currently unavailable.
          </span>
        )}
      </div>
    </form>
  </section>
</MainLayout>

{turnstileSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<script>
  const form = document.getElementById(
    'contribute-form'
  ) as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById(
    'contribute-submit'
  ) as HTMLButtonElement | null;

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!form || !statusEl || !submitBtn) return;

    statusEl.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    try {
      const response = await fetch('/api/contribute', {
        method: 'POST',
        body: new FormData(form),
      });
      let data: { ok?: boolean; error?: string } = {};
      try {
        data = await response.json();
      } catch {
        // A proxy error page (e.g. a 413 from the host) is not JSON.
      }

      if (!response.ok || !data.ok) {
        throw new Error(data.error || 'Submission failed. Please try again.');
      }

      statusEl.textContent = 'Thanks! Your recipe has been published.';
      statusEl.className = 'text-sm text-green-700 dark:text-green-400';
      form.reset();
      window.location.href = '/';
    } catch (error) {
      statusEl.textContent =
        error instanceof Error ? error.message : 'Something went wrong.';
      statusEl.className = 'text-sm text-red-700 dark:text-red-400';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Publish recipe';
    }
  });
</script>
