---
import MainLayout from '@layouts/MainLayout.astro';
import RecipeGrid from '@components/RecipeGrid.astro';
import { Icon } from 'astro-icon/components';
import { listRecipes, parsePage, queryPaging } from '@/lib/catalogue';
import { parseCommunityRecipeDetails } from '@/lib/communityRecipe';
import { supabase } from '@/lib/supabase';

export const prerender = false;

const requestedPage = parsePage(Astro.url.searchParams.get('page'));

const dbRecipes =
  supabase &&
  import.meta.env.PUBLIC_SUPABASE_URL &&
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    ? ((
        await supabase
          .from('recipes')
          .select('*')
          .eq('status', 'published')
          .order('created_at', { ascending: false })
      ).data ?? [])
    : [];

const rows = dbRecipes.map(row => {
  const details = parseCommunityRecipeDetails(row.content || '');
  return {
    id: row.slug ?? row.id,
    collection: 'recipes' as const,
    data: {
      title: row.title || 'Untitled recipe',
      description: row.description || 'Community-submitted recipe.',
      pubDate: new Date(row.created_at || Date.now()),
      cookingTime: Number(row.cooking_time || 0),
      image: row.image_url || '',
      imageAlt: row.image_alt || row.title || 'Recipe image',
      author: row.author || 'community',
      tags: Array.isArray(row.tags) ? row.tags : [],
      steps:
        Array.isArray(row.steps) && row.steps.length > 0
          ? row.steps
          : (details?.steps ?? [
              {
                title: '',
                actions: [
                  row.content || 'Submitted from the community recipe form.',
                ],
              },
            ]),
      ingredients:
        Array.isArray(row.ingredients) && row.ingredients.length > 0
          ? row.ingredients
          : (details?.ingredients ?? [
              { items: [{ name: 'Community recipe' }] },
            ]),
      recipeNotes: Array.isArray(row.recipe_notes)
        ? row.recipe_notes
        : (details?.recipeNotes ?? []),
    },
  };
});
const deletableRecipeIds = new Set(rows.map(recipe => recipe.id));

const recipes = listRecipes(rows, {
  page: requestedPage,
  pathFor: queryPaging('/recipes'),
});

if (recipes.page !== requestedPage) {
  return Astro.redirect(recipes.pathFor(recipes.page));
}

const currentPage = recipes.page;
const canonicalUrl = recipes.pathFor(currentPage);
const pageDescription = `Explore our collection of ${recipes.totalItems} community-crafted recipes. Browse page ${currentPage} of ${recipes.totalPages}.`;
---

<MainLayout
  title="Recipes | Khana Khazana"
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  {/* Heading Section */}
  {currentPage === 1 && (
    <div class="mt-10 py-6 sm:py-8 lg:py-12">
      <div class="corner-squircle from-brand-gold to-brand-warm rounded-[100px] bg-linear-to-br px-4 py-6">
        <section class="flex items-center justify-center gap-6">
          <div class="flex w-10/12 justify-center text-center sm:py-4 md:py-12 lg:w-6/12 lg:py-0 lg:text-left">
            <h1 class="text-dark text-2xl font-bold tracking-tight text-balance md:text-3xl lg:text-4xl xl:text-5xl">
              Explore, cook, and cherish recipes co-created by our global
              community of food enthusiasts.
            </h1>
          </div>
          {/* content - end */}

          {/* image - start */}
          <div class="hidden lg:flex lg:w-3/12">
            <Icon class="h-full w-full" name="food-bowl" />
          </div>
          {/* image - end */}
        </section>
      </div>
    </div>
  )}

  {/* Buttons Container */}
  <div
    class={`flex flex-col ${currentPage === 1 ? '' : 'mt-20'} gap-2.5 sm:flex-row sm:justify-center lg:justify-end`}
  >
    <a
      class="group bg-secondary-accent text-on-brand hover:bg-secondary corner-squircle inline-flex items-center justify-center gap-x-3 rounded-4xl px-8 py-3 text-center text-base font-medium outline-hidden transition duration-300 focus-visible:-translate-y-1 2xl:text-lg"
      href="/contribute"
      data-astro-prefetch
    >
      Add a recipe
      <svg
        class="h-5 w-5 transition duration-300 group-hover:-translate-y-1 group-focus-visible:-translate-y-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4.5v15m7.5-7.5h-15"
        ></path>
      </svg>
    </a>
    <a
      class="group bg-primary text-on-brand hover:shadow-primary corner-squircle inline-flex items-center justify-center gap-x-3 rounded-4xl px-8 py-3 text-center text-base font-medium outline-hidden transition duration-300 hover:shadow-2xl focus-visible:-translate-y-1 2xl:text-lg"
      href="/recipes/saved"
    >
      Saved recipes
      <svg
        class="h-6 w-6 transition duration-300 group-hover:-translate-y-1 group-focus-visible:-translate-y-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M16.5 3.75V16.5L12 14.25 7.5 16.5V3.75m9 0H18A2.25 2.25 0 0 1 20.25 6v12A2.25 2.25 0 0 1 18 20.25H6A2.25 2.25 0 0 1 3.75 18V6A2.25 2.25 0 0 1 6 3.75h1.5m9 0h-9"
        ></path>
      </svg>
    </a>
  </div>

  {/* Recipe Cards */}
  <div class="py-10 lg:py-14">
    {recipes.items.length === 0 ? (
      <div class="mx-auto max-w-2xl rounded-[40px] border border-dashed border-stone-300 bg-stone-50 px-6 py-12 text-center dark:border-stone-700 dark:bg-stone-900/40">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-stone-500 dark:text-stone-400">
          Community kitchen
        </p>
        <h2 class="mt-4 text-3xl font-bold text-stone-900 dark:text-stone-100">
          No recipes yet
        </h2>
        <p class="mt-4 text-lg text-stone-600 dark:text-stone-300">
          Share your favorite dish and help build the collection.
        </p>
        <div class="mt-8 flex justify-center">
          <a
            class="bg-secondary-accent text-on-brand hover:bg-secondary focus-visible:ring-secondary corner-squircle inline-flex items-center justify-center rounded-4xl px-6 py-3 text-sm font-medium transition duration-300 focus:outline-hidden focus-visible:ring-2 2xl:text-base"
            href="/contribute"
            data-astro-prefetch
          >
            Share your recipe
          </a>
        </div>
      </div>
    ) : (
      <RecipeGrid page={recipes} deletableRecipeIds={deletableRecipeIds} />
    )}
  </div>

  {/* Community Card*/}
  {currentPage % 2 === 0 && (
    <div class="mx-auto mb-12">
      <div class="py-6 sm:py-8">
        {/* Flex */}
        <div class="mx-auto flex max-w-(--breakpoint-md) flex-col items-center">
          <div class="flex w-9/12 items-center justify-center 2xl:w-full">
            <Icon class="h-auto w-full" name="recipe-book" />
          </div>
          {/* image - end */}
          <div class="mx-auto mt-5 sm:mt-10 lg:mt-0">
            <div class="space-y-6 sm:space-y-8">
              {/* Title */}
              <div class="mx-auto flex flex-col items-center justify-center px-4 sm:px-6 md:px-0">
                <div class="mx-auto">
                  <p class="text-center text-lg leading-relaxed text-pretty text-stone-600 sm:text-xl 2xl:text-2xl dark:text-stone-400">
                    Passionate about your pesto? Fanatical about your pho?
                    Whatever your specialty, the Khana Khazana community is
                    hungry for your recipes.
                  </p>
                  <div class="mt-8 text-center">
                    <a
                      class="bg-secondary-accent text-on-brand hover:bg-secondary hover:shadow-secondary focus-visible:ring-secondary corner-squircle inline-flex items-center justify-center gap-x-3 rounded-4xl border border-transparent px-4 py-3 text-center text-sm font-medium transition duration-300 hover:shadow-2xl focus:outline-hidden focus-visible:-translate-y-1 focus-visible:ring-2 focus-visible:outline-hidden 2xl:text-base"
                      href="/contribute"
                      data-astro-prefetch
                    >
                      Contribute a recipe
                    </a>
                  </div>
                </div>
                {/* End Title */}
              </div>
            </div>
          </div>
          {/* End Col */}
        </div>
        {/* End Flex */}
      </div>
    </div>
  )}
</MainLayout>
