---
import MainLayout from '@layouts/MainLayout.astro';
import Stepper from '@components/Stepper.astro';
import Tabs from '@components/Tabs.astro';
import Tags from '@components/Tags.astro';
import Ingredients from '@components/Ingredients.astro';
import Bookmark from '@components/Bookmark.astro';
import Clipboard from '@components/Clipboard.astro';
import RecipeImage from '@components/RecipeImage.astro';
import PrintRecipe from '@components/PrintRecipe.astro';
import RecipeCard from '@components/RecipeCard.astro';
import DeleteRecipeButton from '@components/DeleteRecipeButton.astro';
import { relatedRecipes } from '@/lib/catalogue';
import { parseCommunityRecipeDetails } from '@/lib/communityRecipe';
import { supabase } from '@/lib/supabase';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';

export const prerender = false;

async function getSupabaseRecipeBySlug(
  slug: string
): Promise<CollectionEntry<'recipes'> | undefined> {
  if (!supabase) return undefined;

  const { data, error } = await supabase
    .from('recipes')
    .select('*')
    .eq('slug', slug)
    .eq('status', 'published')
    .single();

  if (error || !data) return undefined;

  const details = parseCommunityRecipeDetails(data.content || '');
  return {
    id: data.slug,
    collection: 'recipes',
    data: {
      title: data.title,
      description: data.description || 'Community-submitted recipe.',
      pubDate: new Date(data.created_at || Date.now()),
      cookingTime: Number(data.cooking_time || 0),
      image: data.image_url || '',
      imageAlt: data.image_alt || data.title,
      author: data.author || 'community',
      tags: Array.isArray(data.tags) ? data.tags : [],
      steps:
        Array.isArray(data.steps) && data.steps.length > 0
          ? data.steps
          : (details?.steps ?? [
              {
                title: '',
                actions: [
                  data.content || 'Submitted from the community recipe form.',
                ],
              },
            ]),
      ingredients:
        Array.isArray(data.ingredients) && data.ingredients.length > 0
          ? data.ingredients
          : (details?.ingredients ?? [
              { items: [{ name: 'Community recipe' }] },
            ]),
      recipeNotes: Array.isArray(data.recipe_notes)
        ? data.recipe_notes
        : (details?.recipeNotes ?? []),
      servings: Number(data.servings || 1),
      scalable: data.scalable ?? true,
    },
  };
}

const { slug } = Astro.params;

if (slug === undefined) {
  throw new Error('Slug is required');
}

const contentEntry = await getEntry('recipes', slug);
const supabaseEntry = contentEntry
  ? undefined
  : await getSupabaseRecipeBySlug(slug);
const entry = contentEntry ?? supabaseEntry;
const canShowDeleteButton = Boolean(supabaseEntry);

if (entry === undefined) {
  return Astro.redirect('/404');
}

const allRecipes = await getCollection('recipes');
const related = relatedRecipes(allRecipes, entry.id, 3);

const recipeUrl = Astro.url.href;
const recipeTitle = entry.data.title + ' | Khana Khazana';
const recipeDescription =
  entry.data.description ||
  `Learn how to make ${entry.data.title} with this delicious recipe from Khana Khazana.`;
const recipePath = Astro.url.pathname;
const publishedOn = entry.data.pubDate.toLocaleDateString(undefined, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<MainLayout
  title={recipeTitle}
  description={recipeDescription}
  url={recipeUrl}
  recipe={entry}
>
  <section class="recipe-print-root mt-10 pt-6 sm:pt-8 lg:pt-12">
    <div class="recipe-print-brand" aria-hidden="true">
      <span>Khana Khazana</span>
      <span>Community-crafted recipes</span>
    </div>

    {/* Image Start */}
    <div class="recipe-screen-image mx-auto min-w-full bg-cover">
      <RecipeImage
        image={entry.data.image}
        imageAlt={entry.data.imageAlt}
        class="recipe-hero-image corner-squircle h-80 w-full rounded-[50px] object-cover"
        draggable="false"
        loading="eager"
        width={1600}
        height={900}
        sizes="100vw"
      />
    </div>

    {/* Title Start */}
    <h1 class="text-dark mx-auto mt-10 mb-4 max-w-3xl text-center text-3xl font-bold text-balance sm:text-4xl md:mb-6 md:text-6xl 2xl:max-w-4xl 2xl:text-7xl dark:text-stone-100">
      {entry.data.title}
    </h1>

    {entry.data.description && (
      <p class="mx-auto mb-6 max-w-2xl text-center text-pretty text-stone-600 md:mb-8 md:text-lg 2xl:text-xl dark:text-stone-400">
        {entry.data.description}
      </p>
    )}

    {/* Top Bar Container */}
    <div class="recipe-print-meta mx-auto grid max-w-(--breakpoint-lg) gap-y-5 lg:flex lg:items-center lg:justify-between lg:gap-y-0">
      {/* Author/Date */}
      <div>
        <ul>
          <li class="text-dark relative inline-block pe-6 text-base before:absolute before:end-2 before:top-1/2 before:h-1 before:w-1 before:-translate-y-1/2 before:rounded-full before:bg-stone-400 last:pe-0 last-of-type:before:hidden dark:text-stone-100 dark:before:bg-stone-600">
            {entry.data.author}
          </li>
          <li class="relative inline-block pe-6 text-xs text-stone-500 before:absolute before:end-2 before:top-1/2 before:h-1 before:w-1 before:-translate-y-1/2 before:rounded-full before:bg-stone-400 last:pe-0 last-of-type:before:hidden 2xl:text-sm dark:text-stone-400 dark:before:bg-stone-600">
            {publishedOn}
          </li>
        </ul>
      </div>

      {/* Time/Print/Bookmark */}
      <div class="flex items-center justify-end gap-x-1.5">
        <div class="inline-flex max-w-xs gap-x-2">
          <span class="font-regular group text-dark inline-flex items-center gap-x-2 p-3 text-sm 2xl:text-base dark:text-stone-100">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
              ></path>
            </svg>
            {entry.data.cookingTime} min
          </span>
        </div>

        <div class="no-print mx-3 block h-4 border-e border-stone-400 dark:border-stone-500"></div>

        <div class="no-print inline-flex items-center gap-x-1">
          <PrintRecipe />
          <Bookmark recipeId={entry.id} />
          {canShowDeleteButton && <DeleteRecipeButton slug={slug} />}
        </div>
      </div>
    </div>
  </section>

  <div class="recipe-print-body mx-auto max-w-(--breakpoint-lg)">
    <div class="recipe-print-columns grid gap-y-8 lg:grid-cols-3 lg:gap-x-12 lg:gap-y-0">
      <div class="recipe-print-main lg:col-span-2">
        {/* Instructions Section */}
        <section class="py-6 sm:py-8 lg:py-12">
          <div class="mx-auto max-w-(--breakpoint-lg)">
            <h2 class="text-dark text-3xl font-semibold lg:text-4xl dark:text-stone-100">
              Instructions:
            </h2>

            <Tabs />

            {/* Segment 1 */}
            <div class="mt-3">
              <div
                id="segment-1"
                role="tabpanel"
                aria-labelledby="segment-item-1"
              >
                <Stepper recipe={entry} />
              </div>
            </div>

            {/* Segment 2 / View All Recipe */}
            <div
              id="segment-2"
              class="hidden"
              role="tabpanel"
              aria-labelledby="segment-item-2"
            >
              <ol class="max-w-prose list-inside list-decimal space-y-6">
                {entry.data.steps?.map(step => (
                  <li class="text-dark text-lg font-bold text-balance 2xl:text-xl dark:text-stone-200">
                    {step.title}
                    <ul class="marker:text-secondary dark:marker:text-primary mt-1 list-disc space-y-2 ps-5 leading-normal font-normal text-pretty text-stone-600 2xl:text-xl dark:text-stone-400">
                      {step.actions.map(action => (
                        <li>{action}</li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>

        {/* Recipe Notes Section */}
        <section class="py-6 sm:py-8 lg:py-12">
          {entry.data.recipeNotes && entry.data.recipeNotes?.length > 0 ? (
            <div class="mx-auto max-w-(--breakpoint-lg)">
              <h2 class="text-dark text-3xl font-semibold lg:text-4xl dark:text-stone-100">
                Recipe notes:
              </h2>
              <ul class="marker:text-secondary dark:marker:text-primary mt-4 max-w-prose list-disc space-y-2 ps-5 text-lg leading-normal text-pretty text-stone-600 2xl:text-xl dark:text-stone-400">
                {entry.data.recipeNotes?.map((note: string) => (
                  <li>{note}</li>
                ))}
              </ul>
            </div>
          ) : (
            ''
          )}
        </section>
      </div>

      {/* Sidebar */}
      <div class="recipe-print-ingredients lg:col-span-1 lg:h-full lg:w-full">
        {/* Ingredients Section */}
        <section class="mx-auto max-w-(--breakpoint-lg) py-6 sm:py-8 lg:py-12">
          <h2 class="text-dark text-3xl font-semibold lg:text-4xl dark:text-stone-100">
            Ingredients:
          </h2>
          <Ingredients recipe={entry} />
        </section>
      </div>
    </div>
  </div>
  {/* Bottom Bar Container */}
  <div class="recipe-tags mx-auto grid max-w-(--breakpoint-lg) gap-y-5 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
    {/* Badges/Tags */}
    <div class="flex flex-wrap gap-x-2 gap-y-1 sm:flex-nowrap sm:items-center sm:gap-y-0">
      <Tags tags={entry.data.tags} />
    </div>

    {/* Copy/Print/Bookmark */}
    <div class="no-print flex items-center justify-end gap-x-1.5">
      <Clipboard />
      <div class="mx-3 block h-4 border-e border-stone-400 dark:border-stone-500"></div>
      <div class="inline-flex items-center gap-x-1">
        <PrintRecipe />
        <Bookmark recipeId={entry.id} />
      </div>
    </div>
    {/* End Bottom Bar Container */}
  </div>

  {related.length > 0 && (
    <section class="mx-auto mt-16 max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-center justify-between gap-4">
        <h2 class="text-dark text-3xl font-semibold lg:text-4xl dark:text-stone-100">
          More recipes
        </h2>
        <a
          href="/recipes"
          class="text-secondary hover:text-secondary/80 text-sm font-medium transition-colors dark:text-orange-300 dark:hover:text-orange-200"
        >
          View all recipes
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map(recipe => (
          <RecipeCard recipe={recipe} />
        ))}
      </div>
    </section>
  )}

  <footer class="recipe-print-source" aria-hidden="true">
    <span>Khana Khazana</span>
    <span>{`openstove.org${recipePath}`}</span>
  </footer>
</MainLayout>
