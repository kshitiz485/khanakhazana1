---
export const prerender = true;
import MainLayout from '@layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';
---

<MainLayout
  title="Log in | Khana Khazana"
  description="Log in to Khana Khazana to keep your favorite recipes close and share your own culinary creations."
  canonicalUrl="/login"
>
  <section class="relative overflow-hidden py-10 sm:py-14 lg:py-20">
    <div class="pointer-events-none absolute -top-24 -right-20 hidden h-72 w-72 rounded-full bg-primary/35 blur-3xl lg:block"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-24 hidden h-80 w-80 rounded-full bg-secondary/25 blur-3xl lg:block"></div>

    <div class="relative mx-auto grid max-w-5xl overflow-hidden rounded-[40px] border border-orange-200/70 bg-white/80 shadow-[0_24px_80px_-36px_oklch(45%_0.12_45)] backdrop-blur-sm dark:border-stone-700 dark:bg-stone-900/80 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="from-secondary to-primary flex flex-col justify-between bg-linear-to-br p-8 sm:p-10 lg:p-12">
        <div>
          <span class="inline-flex rounded-full bg-white/55 px-3 py-1 text-xs font-semibold tracking-[0.16em] text-stone-700 uppercase">
            Welcome back
          </span>
          <h1 class="mt-6 max-w-sm text-4xl leading-tight font-bold text-stone-800 sm:text-5xl">
            Keep your kitchen stories close.
          </h1>
          <p class="mt-5 max-w-sm text-base leading-7 text-stone-700 sm:text-lg">
            Sign in to save recipes, revisit family favorites, and share the dishes that make your table feel like home.
          </p>
        </div>

        <div class="mt-12 flex items-center gap-3 text-sm font-medium text-stone-700">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/60">
            <Icon name="recipe-book" class="h-5 w-5" />
          </span>
          Your personal recipe shelf, always ready.
        </div>
      </div>

      <div class="p-8 sm:p-10 lg:p-12">
        <div class="mb-8">
          <p class="text-sm font-medium text-orange-500">Khana Khazana account</p>
          <h2 id="auth-title" class="mt-2 text-3xl font-bold text-dark dark:text-stone-100">Log in to continue</h2>
          <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
            <span id="auth-question">New here?</span>
            <button id="auth-toggle" class="font-semibold text-orange-600 underline decoration-2 underline-offset-4 hover:text-orange-700 dark:text-primary-accent-dark dark:hover:text-primary" type="button">
              Create an account
            </button>
          </p>
        </div>

        <form id="login-form" class="space-y-5" action="#" method="post">
          <div>
            <label class="mb-2 block text-sm font-semibold text-stone-700 dark:text-stone-300" for="email">Email address</label>
            <input class="form-control" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          </div>

          <div id="confirm-password-field" class="hidden">
            <label class="mb-2 block text-sm font-semibold text-stone-700 dark:text-stone-300" for="confirm-password">Confirm password</label>
            <input class="form-control" id="confirm-password" name="confirm-password" type="password" autocomplete="new-password" placeholder="Repeat your password" />
          </div>

          <div>
            <div class="mb-2 flex items-center justify-between gap-4">
              <label class="block text-sm font-semibold text-stone-700 dark:text-stone-300" for="password">Password</label>
              <a class="text-xs font-semibold text-orange-600 hover:text-orange-700 dark:text-primary-accent-dark dark:hover:text-primary" href="#forgot-password">Forgot password?</a>
            </div>
            <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
          </div>

          <label class="flex items-center gap-3 text-sm text-stone-600 dark:text-stone-400">
            <input class="h-4 w-4 rounded border-orange-300 text-orange-500 accent-orange-500 focus:ring-secondary dark:border-stone-600" type="checkbox" name="remember" />
            Keep me signed in
          </label>

          <p id="login-status" class="hidden text-sm" role="status" aria-live="polite"></p>

          <button id="login-submit" class="bg-secondary-accent text-on-brand hover:bg-secondary focus-visible:ring-secondary w-full rounded-4xl px-5 py-3.5 text-sm font-semibold shadow-sm transition hover:-translate-y-0.5 focus:outline-hidden focus-visible:ring-2 disabled:cursor-not-allowed disabled:opacity-60" type="submit">
            Log in
          </button>
        </form>

        <div id="social-login" class="my-7 flex items-center gap-4 text-xs text-stone-400 dark:text-stone-500">
          <span class="h-px flex-1 bg-orange-200 dark:bg-stone-700"></span>
          or continue with
          <span class="h-px flex-1 bg-orange-200 dark:bg-stone-700"></span>
        </div>

        <button id="github-login" class="flex w-full items-center justify-center gap-3 rounded-4xl border border-orange-200 bg-transparent px-5 py-3 text-sm font-semibold text-stone-700 transition hover:-translate-y-0.5 hover:bg-orange-50 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-secondary dark:border-stone-600 dark:text-stone-200 dark:hover:bg-stone-800" type="button">
          <Icon name="github-body" class="h-5 w-5" />
          Continue with GitHub
        </button>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { supabase } from '@/lib/supabase';

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const passwordInput = document.getElementById('password') as HTMLInputElement | null;
  const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement | null;
  const status = document.getElementById('login-status');
  const submit = document.getElementById('login-submit') as HTMLButtonElement | null;
  const githubButton = document.getElementById('github-login') as HTMLButtonElement | null;
  const authTitle = document.getElementById('auth-title');
  const authQuestion = document.getElementById('auth-question');
  const authToggle = document.getElementById('auth-toggle') as HTMLButtonElement | null;
  const confirmPasswordField = document.getElementById('confirm-password-field');
  const socialLogin = document.getElementById('social-login');
  let isSignup = false;

  function showStatus(message: string, success = false) {
    if (!status) return;
    status.textContent = message;
    status.className = success
      ? 'text-sm text-green-700 dark:text-green-400'
      : 'text-sm text-red-700 dark:text-red-400';
  }

  authToggle?.addEventListener('click', () => {
    isSignup = !isSignup;
    authTitle!.textContent = isSignup ? 'Create your account' : 'Log in to continue';
    authQuestion!.textContent = isSignup ? 'Already have an account?' : 'New here?';
    authToggle.textContent = isSignup ? 'Log in' : 'Create an account';
    submit!.textContent = isSignup ? 'Create account' : 'Log in';
    confirmPasswordField?.classList.toggle('hidden', !isSignup);
    confirmPasswordInput?.toggleAttribute('required', isSignup);
    socialLogin?.classList.toggle('hidden', isSignup);
    githubButton?.classList.toggle('hidden', isSignup);
    status?.classList.add('hidden');
  });

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!emailInput || !passwordInput || !submit) return;

    if (!supabase) {
      showStatus('Supabase is not configured yet. Add the public Supabase environment variables.');
      return;
    }

    if (isSignup && passwordInput.value !== confirmPasswordInput?.value) {
      showStatus('Passwords do not match.');
      return;
    }

    submit.disabled = true;
    submit.textContent = 'Logging in...';

    const { data, error } = isSignup
      ? await supabase.auth.signUp({
          email: emailInput.value,
          password: passwordInput.value,
        })
      : await supabase.auth.signInWithPassword({
          email: emailInput.value,
          password: passwordInput.value,
        });

    if (error) {
      showStatus(error.message);
    } else {
      if (isSignup && !data.session) {
        showStatus('Account created. Check your email to confirm your account.', true);
      } else {
        showStatus('Logged in successfully. Redirecting...', true);
        window.location.href = '/';
      }
    }

    submit.disabled = false;
    submit.textContent = 'Log in';
  });

  githubButton?.addEventListener('click', async () => {
    if (!supabase) {
      showStatus('Supabase is not configured yet. Add the public Supabase environment variables.');
      return;
    }

    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'github',
      options: { redirectTo: window.location.origin },
    });

    if (error) showStatus(error.message);
  });
</script>
